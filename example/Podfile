# SyImSDK Example — DEFAULT = OpenIMSDK via CocoaPods (RealOpenImClient).
# HttpWs only with explicit backend: .httpWs
#
#   cd example && pod install
#   open SyImSDKExample.xcworkspace
#
platform :ios, '13.0'
# OpenIMSDKCore ships a static xcframework — must use static linkage
use_frameworks! :linkage => :static

target 'SyImSDKExample' do
  pod 'SyImSDK', :path => '..'
  # Explicit pin (also in SyImSDK.podspec). OpenIM server v3 @ 47.105.48.196
  pod 'OpenIMSDK', '3.8.3+hotfix.3.1'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end
end
